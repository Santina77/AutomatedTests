{
  "name": "automatedtests",
  "version": "1.0.0",
  "private": true,
  "description": "Product manager app + Playwright test suite covering its API and UI",
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
